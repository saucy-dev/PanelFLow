# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MongoDB Atlas URI or local MongoDB)
# Leave empty to automatically use seamless in-memory MongoDB for instant local development/testing!
MONGODB_URI=

# Security
JWT_SECRET=super_secret_panelflow_jwt_key_development_2026_change_in_production
JWT_EXPIRES_IN=7d

# Google Sheets Integration (Optional - CSV paste/upload is also supported out-of-the-box!)
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=
